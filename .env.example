# MongoDB (Atlas connection string, with the database name, e.g. .../evorn?retryWrites=true&w=majority)
MONGODB_URI=

# Cloudinary (Dashboard > API Keys). Either the single URL...
CLOUDINARY_URL=
# ...or the three separate values
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin login at /admin/login. SESSION_SECRET signs the login JWTs: use a long random string (required in production),
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD=
SESSION_SECRET=

# Notifications (Resend email + Text.lk SMS)
RESEND_API_KEY=
EMAIL_FROM=EVORN <onboarding@resend.dev>
ADMIN_NOTIFY_EMAIL=
TEXTLK_API_TOKEN=
TEXTLK_SENDER_ID=TextLKDemo
ADMIN_NOTIFY_PHONE=
