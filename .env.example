# MongoDB (Atlas connection string, with the database name, e.g. .../evorn?retryWrites=true&w=majority)
MONGODB_URI=

# Cloudinary (Dashboard > API Keys). Either the single URL...
CLOUDINARY_URL=
# ...or the three separate values
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin login at /admin/login, and the secret used to sign login cookies (use a long random string)
ADMIN_PASSWORD=
SESSION_SECRET=
